<?xml version="1.0" encoding="utf-8"?>
<!-- Fahrzeug-Widget: oben links Name, Akku-/Tankbalken mit Reichweite und Ladestatus,
     oben rechts das Fahrzeugbild (Schrägansicht) mit Datenstand, unten eine Tastenleiste -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/w_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Mein Opel"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Batteriesymbol: Balken plus Pol. Akku grün, Tank (Verbrenner) orange -->
                <ProgressBar
                    android:id="@+id/w_bar_bat"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="32dp"
                    android:layout_height="14dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_battery"
                    android:progressTint="#FF4CC27E" />

                <ProgressBar
                    android:id="@+id/w_bar_fuel"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="32dp"
                    android:layout_height="14dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_battery"
                    android:progressTint="#FFFFB74D"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="2dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="1dp"
                    android:background="#40FFFFFF" />

                <ImageView
                    android:id="@+id/w_bolt"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Lädt"
                    android:src="@drawable/ic_w_bolt"
                    android:tint="#FF4CC27E" />

                <TextView
                    android:id="@+id/w_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:text="–"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFA0A0A0"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/w_car"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Fahrzeug"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/w_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FFA0A0A0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tastenleiste: Verriegeln, Klima, Laden, Licht. Trennlinien gehören zur jeweils rechten Taste. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_segment_bg"
        android:clipToOutline="true"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/w_btn_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/w_icon_lock"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Verriegeln"
                android:src="@drawable/ic_w_lock" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/w_div_climate"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#26FFFFFF" />

        <FrameLayout
            android:id="@+id/w_btn_climate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/w_icon_climate"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Klimatisierung"
                android:src="@drawable/ic_w_climate" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/w_div_charge"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#26FFFFFF" />

        <FrameLayout
            android:id="@+id/w_btn_charge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/w_icon_charge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Laden"
                android:src="@drawable/ic_w_bolt" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#26FFFFFF" />

        <FrameLayout
            android:id="@+id/w_btn_light"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/w_icon_light"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Lichtsignal"
                android:src="@drawable/ic_w_light" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
