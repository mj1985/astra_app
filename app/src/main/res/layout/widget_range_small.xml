<?xml version="1.0" encoding="utf-8"?>
<!-- Reichweiten-Widget, eine Zeile hoch (2×1): Akku und Tank mit schmalem Balken.
     Gleiche IDs wie widget_range (Gesamtzeile ausgeblendet), damit RangeWidget beide gleich befüllt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_w_bolt"
            android:tint="#FFF7FF14" />

        <TextView
            android:id="@+id/w_soc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="–"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_range_el"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="–"
            android:textColor="#FFE6E6E6"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_soc_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress"
        android:progressTint="#FFF7FF14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:padding="1dp"
            android:src="@drawable/ic_w_fuel"
            android:tint="#FFFFB74D" />

        <TextView
            android:id="@+id/w_fuel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="–"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_range_fuel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="–"
            android:textColor="#FFE6E6E6"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_fuel_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress"
        android:progressTint="#FFFFB74D" />

    <TextView
        android:id="@+id/w_range_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
